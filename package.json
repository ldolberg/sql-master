{
  "name": "sql-snippet-master",
  "displayName": "SQL Snippet Master",
  "description": "AI-powered SQL snippet management with safety guardrails.",
  "version": "0.1.0",
  "publisher": "sql-master",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages", "Data Science"],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "SQL Snippet Master",
      "properties": {
        "sqlSnippetMaster.dialect": {
          "type": "string",
          "enum": ["PostgreSQL", "MySQL", "SQLite", "Snowflake", "BigQuery", "Redshift"],
          "default": "PostgreSQL",
          "description": "SQL dialect for mock runner and AI."
        },
        "sqlSnippetMaster.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Optional Gemini API key for AI features."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sql-snippet-master-sidebar",
          "title": "SQL Master",
          "icon": "icons/activity-bar.svg"
        }
      ]
    },
    "views": {
      "sql-snippet-master-sidebar": [
        {
          "type": "webview",
          "id": "sqlSnippetMasterView",
          "name": "SQL Snippet Master"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.3"
  }
}
